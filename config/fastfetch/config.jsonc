{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "color": { "1": "37", "2": "90" },
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "90",
      "title": "97",
      "output": "37",
      "separator": "90"
    },
    "key": { "width": 10 },
    "bar": {
      "char": { "elapsed": "■", "total": "·" },
      "border": { "left": "", "right": "" },
      "width": 12
    },
    "percent": {
      "type": 3,
      "color": { "green": "37", "yellow": "97", "red": "97" }
    }
  },
  "modules": [
    "break",
    { "type": "title", "format": "{user-name}@{host-name}" },
    { "type": "custom", "format": "\u001b[90m──────────────────────────" },
    { "type": "os", "key": "os", "format": "{pretty-name}" },
    { "type": "kernel", "key": "kernel", "format": "{release}" },
    { "type": "wm", "key": "wm", "format": "{pretty-name}" },
    { "type": "shell", "key": "shell", "format": "{pretty-name}" },
    { "type": "terminal", "key": "term", "format": "{pretty-name}" },
    { "type": "packages", "key": "pkgs" },
    { "type": "uptime", "key": "uptime" },
    "break",
    { "type": "cpu", "key": "cpu", "format": "{name}" },
    { "type": "gpu", "key": "gpu", "format": "{name}" },
    { "type": "memory", "key": "ram", "format": "{used} / {total}  {percentage-bar}" },
    { "type": "disk", "key": "disk", "folders": "/", "format": "{size-used} / {size-total}  {size-percentage-bar}" },
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 0 }
  ]
}
